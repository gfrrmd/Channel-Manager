# Wajib
BOT_TOKEN=123456:ABC-your-token
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Opsional
# Kosongkan = semua orang boleh pakai bot. Isi user id dipisah koma untuk membatasi.
ALLOWED_USERS=
DEFAULT_TZ=Asia/Jakarta
# auto  = coba rich message (button di dalam teks), fallback ke inline keyboard biasa
# rich  = hanya rich message
# classic = hanya inline keyboard biasa
RICH_MODE=auto
SCHEDULER_INTERVAL=15
LOG_LEVEL=INFO
